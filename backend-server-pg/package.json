{
  "name": "krakenges-backend-pg",
  "version": "0.1.0",
  "private": true,
  "description": "Kraken Ges backend sobre PostgreSQL (Drizzle ORM)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "keys:pub": "tsx scripts/print-public-key.ts",
    "generate:secret": "tsx scripts/generate-secret.ts",
    "migrate:mongo": "tsx scripts/import-mongo-json.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "speakeasy": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.7",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
