{
  "name": "krakenges-backend",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "jest",
    "test:e2e": "MONGOMS_VERSION=5.0.31 jest --runInBand --testPathPattern=e2e.license-flow.test.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "generate:secret": "node -e \"console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('hex'))\"",
    "keys:generate": "node scripts/gen-license-keys.mjs",
    "secrets:migrate": "node scripts/migrate-secret-hashes.mjs",
    "seed:owner": "node scripts/seed-owner.mjs",
    "keys:pub": "node -e \"const c=require(\"crypto\"),f=require(\"fs\"),p=require(\"path\");const d=process.env.KRAKENGES_LICENSE_KEYS_DIR||p.join(__dirname,\".keys\");const pk=c.createPublicKey(f.readFileSync(p.join(d,\"license_ed25519_pub.pem\")));console.log(pk.export({type:\"spki\",format:\"der\"}).toString(\"base64\"))\""
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.11",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
