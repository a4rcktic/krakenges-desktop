# ---------------------------------------------------------------------------
# Firma del APK de release — plantilla
#
# Copia este archivo a `keystore.properties` (mismo directorio) y rellena los
# valores. `keystore.properties` está en .gitignore y NUNCA debe subirse.
#
# La keystore real vive FUERA del repo (por ejemplo en ~/.config/<tu-app>/,
# con permisos 0600). Cómo crearla: docs/PUESTA-EN-MARCHA.md, paso 3.
#
# Sin este archivo, `./gradlew assembleRelease` produce un APK SIN FIRMAR
# (y avisa por consola). Eso es intencional: mejor un release sin firmar que
# uno firmado con una clave filtrada.
# ---------------------------------------------------------------------------

storeFile=/ruta/absoluta/a/release.keystore
storePassword=CAMBIAR_POR_LA_CLAVE_REAL
keyAlias=CAMBIAR_POR_TU_ALIAS
keyPassword=CAMBIAR_POR_LA_CLAVE_REAL
