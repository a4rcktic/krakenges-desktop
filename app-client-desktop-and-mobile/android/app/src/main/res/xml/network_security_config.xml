<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Kraken Ges Security Layer: Forbid cleartext traffic and block user-installed proxy CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
