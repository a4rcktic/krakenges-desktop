# Copia este fichero a /etc/krakenges/backup.env y ajusta los valores.
# Permisos recomendados: root:backup 0640 (el servicio corre como backup).
# No versiones este fichero: contiene la contraseña de MongoDB.

MONGO_URI=mongodb://usuario_backup:CAMBIAR_ESTA_CLAVE@127.0.0.1:27017/krakenges?authSource=admin
MONGO_DB=krakenges
BACKUP_DIR=/var/backups/krakenges
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7

# Elige UNO de los dos. Es una clave PÚBLICA, no la privada.
# age:
# BACKUP_AGE_RECIPIENT=age1...
# GPG (huella o clave pública; el servicio usa GNUPGHOME=/var/lib/krakenges-backup/gnupg):
# BACKUP_GPG_RECIPIENT=ABCDEF0123456789
