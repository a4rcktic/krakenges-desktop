# ---------------------------------------------------------------------------
# Kraken Ges Backend — variables de entorno
# Copia este fichero a `.env` y rellena los valores. NUNCA subas `.env` al repo.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
# Puerto de la API. En producción Apache (o nginx) proxya desde 443 hacia 127.0.0.1:PORT.
PORT=4000
# Bind a loopback por defecto (defensa en profundidad detrás de Apache/nginx).
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info
LOG_DIR=logs

# --- Base de datos ----------------------------------------------------------
# MongoDB. El usuario de aplicación NO debe ser root.
MONGODB_URI=mongodb://krakenges_app:CAMBIAR_ESTA_CLAVE@127.0.0.1:27017/krakenges?authSource=krakenges

# --- Autenticación (OBLIGATORIO) -------------------------------------------
# Generar con: npm run generate:secret
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Clave para firmar los tickets de licencia. Si se define
# KRAKENGES_LICENSE_PRIVATE_KEY (PEM) tiene prioridad sobre el directorio de claves.
SESSION_SECRET=
KRAKENGES_LICENSE_KEYS_DIR=keys
# KRAKENGES_LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- CORS -------------------------------------------------------------------
# Lista separada por comas de orígenes permitidos. `*` se IGNORA a propósito.
CORS_ORIGIN=https://app.krakenchk.com,https://www.app.krakenchk.com

# --- URLs públicas (marca / dominio) ---------------------------------------
# tools/brand/apply.mjs actualiza estos valores desde brand.config.json.
# APP_PUBLIC_URL se usará en enlaces de correo (reset, verificación).
PUBLIC_BASE_URL=https://app.krakenchk.com
DOWNLOAD_BASE_URL=https://app.krakenchk.com/downloads
APP_PUBLIC_URL=https://app.krakenchk.com
RELEASE_DATE=2026-10-01T00:00:00.000Z

# --- Correo (reset de contraseña) -------------------------------------------
# Resend (https://resend.com). Sin estas dos variables, /forgot-password
# responde 503 en vez de generar un token que nunca se envía.
RESEND_API_KEY=
MAIL_FROM=

# --- Updater ----------------------------------------------------------------
# Manifiesto generado por tools/updater-manifest/generate.mjs.
# Si el fichero no existe, /api/updates/manifest responde 204.
UPDATER_MANIFEST_PATH=updater-manifest.json

# --- Proxies ----------------------------------------------------------------
# El servidor NO debe almacenar proxies (política del proyecto: el cliente los
# guarda en su máquina). Esta clave solo es necesaria para DESCIFRAR proxies
# legacy que quedaran en la base de datos de instalaciones anteriores.
# Formatos: 32 bytes en base64 con prefijo `b64:`, o cualquier string (se hashea).
# KRAKENGES_PROXY_ENCRYPTION_KEY=b64:TU_CLAVE_AQUI
