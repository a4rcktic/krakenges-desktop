# ---------------------------------------------------------------------------
# Kraken Ges Backend (PostgreSQL) — variables de entorno
# Copia este fichero a `.env` y rellena los valores. NUNCA subas `.env`.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
PORT=8010
# Loopback por defecto: el reverse proxy hace el proxy desde 443.
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# --- Base de datos ----------------------------------------------------------
# PostgreSQL local. El usuario de aplicación NO debe ser superusuario.
# En local (loopback) sslmode=disable; si usas un Postgres remoto, exige TLS.
DATABASE_URL=postgres://krakenges_app:CAMBIAR_ESTA_CLAVE@127.0.0.1:5432/krakenges?sslmode=disable
DB_POOL_MAX=20

# --- Autenticación (OBLIGATORIO) -------------------------------------------
# Debe ser el MISMO JWT_SECRET que usa el backend actual para que los tokens
# existentes sigan siendo válidos durante la transición.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Clave para firmar los tickets de licencia. Si se define
# KRAKENGES_LICENSE_PRIVATE_KEY (PEM en base64) tiene prioridad sobre el
# directorio de claves. También se acepta el nombre legacy MASKOS_*.
KRAKENGES_LICENSE_KEYS_DIR=.keys
# KRAKENGES_LICENSE_PRIVATE_KEY=

# --- CORS -------------------------------------------------------------------
# Lista separada por comas. `*` se IGNORA a propósito.
CORS_ORIGIN=https://app.krakenchk.com,https://www.app.krakenchk.com

# --- URLs públicas (marca / dominio) ---------------------------------------
PUBLIC_BASE_URL=https://app.krakenchk.com
DOWNLOAD_BASE_URL=https://app.krakenchk.com/downloads
APP_PUBLIC_URL=https://app.krakenchk.com
RELEASE_DATE=2026-10-01T00:00:00.000Z

# --- Correo (reset de contraseña) -------------------------------------------
# Resend. Sin estas dos variables, /forgot-password responde 503.
RESEND_API_KEY=
MAIL_FROM=

# --- Updater ----------------------------------------------------------------
UPDATER_MANIFEST_PATH=updater-manifest.json

# --- Contenido público ------------------------------------------------------
# En producción: /opt/krakenges/content/public-content.json
PUBLIC_CONTENT_PATH=content/public-content.json

# --- Proxies legacy ---------------------------------------------------------
# Se usa para descifrar proxies antiguos. El servidor no guarda proxies
# nuevos. Formatos: 32 bytes en base64 con prefijo `b64:`, o cualquier string
# (se hashea). Debe coincidir con la clave del backend actual.
# KRAKENGES_PROXY_ENCRYPTION_KEY=b64:TU_CLAVE_AQUI
